# Discord Developer Portal (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: restrict slash-command registration to one server for instant updates while testing.
# Leave blank to register commands globally (takes up to an hour to propagate).
DISCORD_GUILD_ID=

# Anthropic API key, used for AI-assisted moderation of borderline messages.
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Channel Claude should post the welcome message in when a member joins.
WELCOME_CHANNEL_ID=
# Role automatically granted to new members (optional).
AUTO_ROLE_ID=
# Channel moderation actions and AI decisions get logged to.
MOD_LOG_CHANNEL_ID=
