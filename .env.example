# Copy to `.env` for LOCAL use only. `.env` is gitignored and must never be
# committed. On the live server, these values live in the server's own config
# (e.g. wp-config.php), which the pipeline does NOT overwrite.
#
# These are placeholders — replace with your real values locally, and set the
# deploy credentials as GitHub Actions secrets (see docs/SETUP.md), not here.

# --- Database (example for a PHP/WordPress site) ---
DB_HOST=localhost
DB_NAME=your_database
DB_USER=your_db_user
DB_PASSWORD=change_me

# --- Site ---
SITE_URL=https://jsonformatterpro.com

# The actual Hostinger deploy credentials (SSH host/user/port/key/path, or FTP)
# are stored as GitHub Actions secrets, NOT in this file.
