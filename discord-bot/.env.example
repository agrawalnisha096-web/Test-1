# Discord Developer Portal (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: restrict slash-command registration to one server for instant updates while testing.
# Leave blank to register commands globally (takes up to an hour to propagate).
DISCORD_GUILD_ID=

# Anthropic API key, used for AI-assisted moderation of borderline messages.
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Channel Claude should post the welcome message in when a member joins.
WELCOME_CHANNEL_ID=
# Role automatically granted to new members (optional).
AUTO_ROLE_ID=
# Channel moderation actions and AI decisions get logged to.
MOD_LOG_CHANNEL_ID=

# Reddit account verification (register an app at https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Must exactly match the redirect URI configured on the Reddit app, and be
# publicly reachable over HTTPS (e.g. https://yourdomain.com/reddit/callback).
REDDIT_REDIRECT_URI=
# Reddit requires a descriptive User-Agent identifying your app.
REDDIT_USER_AGENT=discord-community-bot/1.0 (by /u/your-reddit-username)
# Role granted to members who pass verification.
VERIFIED_ROLE_ID=
# Random long string used to sign OAuth state tokens. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Minimum thresholds to pass verification.
MIN_TOTAL_KARMA=100
MIN_COMMENT_KARMA=20
MIN_ACCOUNT_AGE_DAYS=365
# Port the verification callback server listens on.
VERIFICATION_PORT=3000
# Where the SQLite verification database file is stored.
DATABASE_PATH=./verifications.db
